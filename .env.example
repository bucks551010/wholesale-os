# Copy this file to .env and fill in your values
# Never commit .env to git

# --- Railway PostgreSQL ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Target ZIPs (comma-separated, no spaces) ---
TARGET_ZIPS=77080,77055,77043,77041,77004,77003,77021,77009,77022,77076,77093,77011,77020,77091,77018,77088,77373,77375,77377,77092,77014,77028,77016,77026,77051,77033,77072,77083,77099,77036,77074,77081,77019,77005,77027,77056,77030,77098,77024,77401,77058,77389,77388,77386

# --- HCAD Data ---
# Download from https://pdata.hcad.org/download/
# Set to local path after downloading, or leave blank to auto-download
HCAD_DATA_DIR=./data/hcad
HCAD_YEAR=2025

# --- Google Sheets (optional, for exports) ---
GOOGLE_SHEETS_CREDS_JSON=

# --- Gmail SMTP (for alerts) ---
SMTP_FROM_EMAIL=
SMTP_APP_PASSWORD=

# --- App settings ---
APP_TITLE=WholesaleOS
DEBUG=false
